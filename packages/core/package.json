  "keywords": [
    "online-learning",
    "machine-learning",
    "neural-network",
    "incremental-learning"
  ],
  "author": "SylphxAI",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2",
    "@biomejs/biome": "^2.3.12",
    "@sylphx/biome-config": "^0.4.1"
  },
  "sideEffects": false
}
